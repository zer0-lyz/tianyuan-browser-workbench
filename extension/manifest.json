{
  "manifest_version": 3,
  "name": "天源浏览器工作台",
  "description": "天源页面连接、资产基础法批量处理、表格导出和打印格式工作台。",
  "version": "0.14.8",
  "version_name": "0.14.8",
  "key": "",
  "action": {
    "default_title": "天源工作台"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://excel.zhrdc.net/ty/*",
    "https://feedback.zer0y.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:40415/*"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excel.zhrdc.net/ty/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected/page_adapter.js"
      ],
      "matches": [
        "https://excel.zhrdc.net/*"
      ]
    }
  ]
}
